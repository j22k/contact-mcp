# No domain yet, so this serves plain HTTP on port 80 and can't get an
# automatic Let's Encrypt certificate (that requires a real domain name).
# Set ALLOWED_HOSTS to this server's public IP so the app's DNS-rebinding
# protection accepts it (see docker-compose.yml).
#
# Once you have a domain, point its A record at this VPS and replace the
# block below with:
#   your-domain.example.com {
#       reverse_proxy mcp-server:8008
#   }
# and update ALLOWED_HOSTS to match — Caddy will then handle HTTPS automatically.
:80 {
	reverse_proxy mcp-server:8008
}
