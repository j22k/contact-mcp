# Copy this file to .env and fill in real values, then run:
#   docker compose up -d --build
# docker compose reads .env automatically for the ${VAR} substitutions below.

# Required. This server's public IP (or domain, once you have one) — e.g. 203.0.113.5.
# Must match the address block in Caddyfile. Enables DNS-rebinding protection;
# compose refuses to start without this set.
ALLOWED_HOSTS=203.0.113.5

# Optional. Per-client-IP request cap across all routes (dashboard, delete, /mcp).
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
