# Copy this file to .env and fill in real values, then run:
#   docker compose up -d --build
# docker compose reads .env automatically for the ${VAR} substitutions below.

# Required. Comma-separated list of hosts this server should accept — the
# bare IP, a domain if you have one, or both (matching the site blocks in
# Caddyfile). Enables DNS-rebinding protection; compose refuses to start
# without this set.
ALLOWED_HOSTS=203.0.113.5,your-domain.example.com

# Optional. Per-client-IP request cap across all routes (dashboard, delete, /mcp).
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
